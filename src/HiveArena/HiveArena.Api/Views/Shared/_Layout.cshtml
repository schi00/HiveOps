<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HiveArena</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 2rem; max-width: 960px; }
        h1 { color: #2c3e50; }
        .grid { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
        button { padding: .6rem 1rem; cursor: pointer; border-radius: 6px; border: 1px solid #ccc; background: #f8f9fa; }
        button:hover { background: #e9ecef; }
        #log { margin-top: 1.5rem; white-space: pre-wrap; background: #111; color: #0f0; padding: 1rem; border-radius: 8px; min-height: 120px; font-size: 12px; }
        .hint { color: #666; font-size: 0.9rem; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
